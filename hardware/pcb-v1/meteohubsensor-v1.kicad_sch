		(uuid "a6e73988-d23f-5844-a259-6343cf584da3")
	)
	(text "Repere des broches du S3 = repere imprime sur le module (TX, RX, 1..7 a gauche ; 5V, GND, 3V3, 13..8 a droite). GPIO3, 6, 10..13, TX, RX, 5V : libres."
		(exclude_from_sim no)
		(at 30.48 45.72 0)
